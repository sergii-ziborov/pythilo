# Public reverse proxy for the Pythilo site on loopback port 3212.
# Replace __PYTHILO_DOMAIN__ with the real domain (see DEPLOY.md). Enable the HTTPS
# server only after the certificate for that domain exists.
map $uri $pythilo_referrer_policy {
    default strict-origin-when-cross-origin;
    ~^/playground/room/ no-referrer;
    ~^/api/playground/ no-referrer;
}

server {
    listen 80;
    listen [::]:80;
    server_name __PYTHILO_DOMAIN__;
    access_log /var/log/pythilo/access.log;
    error_log /var/log/pythilo/error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://__PYTHILO_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __PYTHILO_DOMAIN__;
    access_log /var/log/pythilo/access.log;
    error_log /var/log/pythilo/error.log;

    ssl_certificate /etc/letsencrypt/live/__PYTHILO_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PYTHILO_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy $pythilo_referrer_policy always;

    # Ciphertext relay only. Room links carry their key in the fragment, which never
    # reaches the server; the path alone is not logged. Buffering stays off so edits,
    # presence and runtime messages arrive immediately.
    location ^~ /api/playground/ {
        access_log off;
        # A room's 256 KiB snapshot is about 350,000 JSON characters; the relay enforces 400,000.
        client_max_body_size 400k;
        client_body_timeout 10s;
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header Referrer-Policy;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 15s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store" always;
    }

    # Pyodide and its packages, about 18 MB, change only with a release.
    location ^~ /pyodide/ {
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        gzip on;
        gzip_types application/wasm application/javascript text/javascript application/json;
    }

    # Room pages carry the room key in the fragment only; keep them out of the access log anyway.
    location ^~ /playground/room/ {
        access_log off;
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Referrer-Policy;
    }

    location / {
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header Referrer-Policy;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
}
