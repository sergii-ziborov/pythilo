{
  "name": "pythilo-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && next dev -H 127.0.0.1 -p 3212",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start -H 127.0.0.1 -p 3212",
    "check": "node scripts/prepare-assets.mjs --content-only && tsc --noEmit",
    "test": "node scripts/prepare-assets.mjs --content-only && node --experimental-wasm-jspi --experimental-strip-types --no-warnings=ExperimentalWarning --test tests/*.test.mjs",
    "bridge": "node scripts/build-playground-bridge.mjs",
    "prepare-mcp": "node scripts/prepare-mcp-download.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "fflate": "0.8.3",
    "next": "16.4.2",
    "pyodide": "314.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
