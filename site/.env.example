# The public origin of this site, for example https://<your-domain>. Requests to the
# relay from any other browser origin are refused. Unset, the request's own origin is used.
SITE_ORIGIN=http://127.0.0.1:3212
# Optional: where "Get the iPhone app" points. Unset, it points to the app section on the home page.
# NEXT_PUBLIC_APP_STORE_URL=
